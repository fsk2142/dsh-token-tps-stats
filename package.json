{
  "name": "dsh-token-tps-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live output speed (tok/s) for the current DSH session, shown next to the composer stats pills",
  "license": "MIT",
  "author": "fsk2142",
  "homepage": "https://github.com/fsk2142/dsh-token-tps-stats#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsk2142/dsh-token-tps-stats.git"
  },
  "bugs": {
    "url": "https://github.com/fsk2142/dsh-token-tps-stats/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tokens",
    "tok/s",
    "tps",
    "stats"
  ],
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "node scripts/smoke-client.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.24.0"
}
